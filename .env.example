# Copy this file to .env and adjust. Every value has a working local default
# except SECRET_KEY, which you should replace before deploying anywhere.

# Postgres connection (matches docker-compose.yml in the project root)
DATABASE_URL=""

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# How long a login lasts, in minutes (default: 7 days)
ACCESS_TOKEN_MINUTES=10080

# Where the Vue app is served from. Comma-separated. Used for CORS.
CORS_ORIGINS=http://localhost:5173

# Public address of the site. Used for links in the RSS feed.
SITE_URL=http://localhost:5173
SITE_TITLE=Anish Tilloo
SITE_DESCRIPTION=Notes and articles on full-stack engineering, PostgreSQL and LLM tooling.
